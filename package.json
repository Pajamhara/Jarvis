{
  "name": "astra",
  "productName": "Astra",
  "version": "0.1.0",
  "description": "Astra",
  "main": "src/main/main.js",
  "author": "Pajamhara",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.astra.finance",
    "productName": "Astra",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Astra"
    },
    "publish": {
      "provider": "github",
      "owner": "Pajamhara",
      "repo": "astra",
      "releaseType": "release"
    }
  }
}
